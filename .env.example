# Dashboard: run npm run dashboard:setup -- admin to generate these settings.
DASHBOARD_PORT=4173
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
# Optional exact origin when hosting behind a proxy, without a trailing slash.
# DASHBOARD_ORIGIN=https://your-dashboard.example.com
# DASHBOARD_CACHE_DIR=/path/to/persistent/cache

# Google service account: keep this file private and outside public/static assets.
GOOGLE_SERVICE_ACCOUNT_KEY=service-account.json
# On Vercel use the service-account JSON in this server-only variable instead.
# GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_LOTUSPSYCHIATRYANDWELLNESS_COM=
GOOGLE_SPREADSHEET_ID=
# Direct Google connections use IPv4 by default; alternatives: auto, 6.
GOOGLE_API_IP_FAMILY=4

# Scraper / optional AI recommendations
PAGESPEED_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# Report email (the scraper sends reports to its configured recipients)
EMAIL_USER=
EMAIL_PASS=

# Optional Microsoft Clarity
CLARITY_PROJECT_ID=
CLARITY_API_TOKEN=

# Private Vercel Blob report storage. Copy the project's token into local .env
# for npm run reports:upload. On Vercel, report storage uses Blob automatically.
BLOB_READ_WRITE_TOKEN=
# DASHBOARD_REPORT_STORAGE=blob
